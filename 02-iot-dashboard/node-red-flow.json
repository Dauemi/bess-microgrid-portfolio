    {
        "id": "split",
        "type": "function",
        "z": "flow_bms",
        "name": "Split fields",
        "func": "const d = msg.payload;\nreturn [\n  { payload: d.soc },\n  { payload: d.t },\n  { payload: d.v, topic: \"Voltage\" },\n  { payload: d.i, topic: \"Current\" },\n  { payload: (d.status === \"OK\" ? \"🟢 \" : \"🔴 \") + d.status }\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 220,
